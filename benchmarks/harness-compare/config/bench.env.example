# hcbench configuration. Copy to config/bench.env and edit:
#   cp config/bench.env.example config/bench.env
# Every script sources this file; Python reads the exported variables.
# Values here are pre-registered: changing one after the pre-registration
# commit is a deviation and must be logged in DEVIATIONS.md.

# ---------------------------------------------------------------- model server
# vllm (default) or llamacpp
HC_SERVER=vllm
# Name the harnesses send as "model"; the proxy forces it on every request.
HC_SERVED_NAME=qwen3-coder-30b-a3b
# A 4-bit build of Qwen3-Coder-30B-A3B-Instruct. FP8 (~31 GB of weights) does NOT fit
# a 32 GB RTX 5090 with KV cache. Pick an AWQ/GPTQ repo and pin its commit below.
HC_MODEL_HF=CHANGE-ME/Qwen3-Coder-30B-A3B-Instruct-AWQ
HC_MODEL_REVISION=CHANGE-ME-commit-sha
# Qwen3-Coder emits XML-style tool calls: use the qwen3_coder parser, not hermes.
# (hermes is right for Qwen2.5-Coder.)
HC_TOOL_PARSER=qwen3_coder
# Pin an image tag that supports Blackwell (sm_120); preflight checks the GPU only.
HC_VLLM_IMAGE=vllm/vllm-openai:CHANGE-ME
# 64k context: Hone sizes its own context from the model name (any "qwen" →
# 128k advertised × 0.45 = 57.6k budget) and has no override, so a 32k server
# makes Hone overflow before it compacts. 57.6k + HC_MAX_TOKENS must stay < this.
HC_MAX_MODEL_LEN=65536
HC_GPU_MEM_UTIL=0.92
HC_KV_CACHE_DTYPE=fp8
HC_MAX_NUM_SEQS=4
# llama.cpp alternative (HC_SERVER=llamacpp)
HC_LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
HC_GGUF_PATH=/models/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf
HC_HF_CACHE=${HOME}/.cache/huggingface

# ------------------------------------------- sampling (enforced by the proxy)
HC_TEMPERATURE=0
HC_TOP_P=1
HC_MAX_TOKENS=6144

# ------------------------------------------------- per-run caps (proxy + wall)
HC_MAX_REQUESTS=80
HC_MAX_TOTAL_TOKENS=3000000
HC_TIMEOUT_S=1800

# ------------------------------------------------------------------- docker
HC_UPNET=hc-up
HC_NET=hc-net
HC_LLM_PORT=8000
HC_PROXY_PORT=8100
HC_SINK_PORT=8180
HC_CPUS=4
HC_MEMORY=8g
HC_MINI_IMAGE=hc-mini:latest
HC_REDTEAM_IMAGE=hc-redteam:latest
HC_TOOLS_IMAGE=hc-tools:latest
# Instance images are pulled from Docker Hub by name (swebench >= 5 convention).
HC_SWE_NAMESPACE=swebench

# ---------------------------------------------------------- harness bundle
HC_BUNDLE_DIR=${HC_ROOT}/.bundle
# git ref of Hone to benchmark (built in a clean worktree, never the dirty tree)
HC_HONE_REF=HEAD
HC_RUST_IMAGE=rust:1-slim-bullseye
HC_PI_VERSION=0.73.1
HC_NODE_VERSION=22.11.0
# Hermes Agent (NousResearch/hermes-agent) release tag, installed from git into the bundle.
# HC_HERMES_REF is a tag or a full SHA (never a branch); HC_HERMES_SHA must equal what it resolves to.
# v2026.9.24 = commit f97608f178d1ffeca59860195ab7da295f7c8e5f (latest tag on 2026-11-09)
HC_HERMES_REF=v2026.9.24
HC_HERMES_SHA=f97608f178d1ffeca59860195ab7da295f7c8e5f
# Python for Hermes (python-build-standalone via uv; Hermes needs >=3.11,<3.14)
HC_HERMES_PYTHON=3.12
HC_UV_VERSION=0.10.9
# sha256 of uv-x86_64-unknown-linux-gnu.tar.gz for HC_UV_VERSION (official release asset)
HC_UV_SHA256=20d79708222611fa540b5c9ed84f352bcd3937740e51aacc0f8b15b271c57594
# Build image for the Hermes venv, pinned by digest (ubuntu:22.04 index; built for linux/amd64)
HC_HERMES_BUILD_IMAGE=ubuntu@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
# Where to fetch Pi's example guardrail extensions if the npm package lacks them
HC_PI_EXT_REF=main

# --------------------------------------------------------- task selection
HC_SWE_DATASET=SWE-bench/SWE-bench_Lite
HC_SWE_SPLIT=test
HC_SWE_DATASET_REVISION=
HC_SWE_N=40
HC_SELECTION_SEED=20261109
HC_REPEATS=0,1,2
HC_CONCURRENCY=4
HC_GRADE_WORKERS=8

# ------------------------------------------------------------- arms & cost
HC_ARMS_MAIN=pi,hone-noinject,hone-inject,hermes
HC_ARMS_REDTEAM=pi,pi-guarded,hone-inject,hone-guarded,hermes,hermes-guarded
# Reference $/1M tokens used for the cost column (e.g. OpenRouter list price
# for the same model on pre-registration day). Record the source in prereg.
HC_PRICE_IN_PER_M=0
HC_PRICE_OUT_PER_M=0
