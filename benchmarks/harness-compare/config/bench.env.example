# hcbench configuration. Copy to config/bench.env and edit:
#   cp config/bench.env.example config/bench.env
# Every script sources this file; Python reads the exported variables.
# Values here are pre-registered: changing one after the pre-registration
# commit is a deviation and must be logged in DEVIATIONS.md.

# ---------------------------------------------------------------- model server
# vllm (default) or llamacpp
HC_SERVER=vllm
# Name the harnesses send as "model"; the proxy forces it on every request.
HC_SERVED_NAME=qwen3.8-27b
# NVFP4 build of Qwen3.8-27B (Apache-2.0); fits one 32 GB RTX 5090. Pin its commit below.
HC_MODEL_HF=Inferact/Qwen3.8-27B-NVFP4
HC_MODEL_REVISION=CHANGE-ME-commit-sha
# Qwen emits XML-style tool calls: use the qwen3_coder parser, not hermes.
HC_TOOL_PARSER=qwen3_coder
HC_REASONING_PARSER=qwen3
# One 5090 needs eager mode (CUDA graph capture runs out of memory); the language-model-only
# flag drops the vision encoder so the KV pool grows. 1 = pass the flag, anything else = omit.
HC_ENFORCE_EAGER=1
HC_LANGUAGE_MODEL_ONLY=1
# MTP speculative decoding (lossless). Single-quoted: the scripts `source` this file, and
# unquoted JSON would lose its double quotes. Empty = off.
HC_SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
# vLLM >= 0.26 with Blackwell (sm_120) support; preflight checks the GPU only. Pin the image by
# digest: vllm/vllm-openai:<tag>@sha256:<digest> (look it up with
# `docker buildx imagetools inspect <image>`). 02_serve_model.sh and a non-draft pre-registration
# refuse an image without @sha256:<64 lowercase hex>.
HC_VLLM_IMAGE=vllm/vllm-openai:CHANGE-ME
# 64k context. Every harness is told this window: Pi and Hermes through their model config,
# Hone through HONE_CONTEXT_WINDOW ({{context_window}} in config/arms.toml). Hone budgets
# 0.45 x the window (about 29.5k at 65536) and compacts as shipped. 0.45 is Hone's ratio for a
# served name containing "qwen" (HC_SERVED_NAME); it is not a general rule.
HC_MAX_MODEL_LEN=65536
HC_GPU_MEM_UTIL=0.92
HC_KV_CACHE_DTYPE=fp8
HC_MAX_NUM_SEQS=4
# llama.cpp alternative (HC_SERVER=llamacpp). Pin this image by digest too:
# ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:<digest> (required when HC_SERVER=llamacpp).
HC_LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
HC_GGUF_PATH=/models/Qwen3.8-27B-Q4_K_M.gguf
HC_HF_CACHE=${HOME}/.cache/huggingface

# ------------------------------------------- sampling (enforced by the proxy)
# Qwen non-thinking settings. The proxy replaces whatever the harness sends with these and
# drops every other sampling and thinking knob (spec 11.2 K5-K7).
HC_TEMPERATURE=0.7
HC_TOP_P=0.8
HC_TOP_K=20
HC_MIN_P=0
HC_PRESENCE_PENALTY=1.5
HC_REPETITION_PENALTY=1.0
HC_MAX_TOKENS=6144
# false or true; forced as chat_template_kwargs on every request and as the server default.
HC_ENABLE_THINKING=false
# The seed sent upstream for repeat r is HC_SEED_BASE + r (run ids stay s<r>).
HC_SEED_BASE=20261117

# ------------------------------------------------- per-run caps (proxy + wall)
HC_MAX_REQUESTS=80
HC_MAX_TOTAL_TOKENS=3000000
HC_TIMEOUT_S=1800

# ------------------------------------------------------------------- docker
HC_UPNET=hc-up
HC_NET=hc-net
HC_LLM_PORT=8000
HC_PROXY_PORT=8100
HC_SINK_PORT=8180
HC_CPUS=4
HC_MEMORY=8g
HC_PIDS_LIMIT=4096
HC_MINI_IMAGE=hc-mini:latest
HC_REDTEAM_IMAGE=hc-redteam:latest
HC_TOOLS_IMAGE=hc-tools:latest
# Instance images are pulled from Docker Hub by name (swebench >= 5 convention).
# HC_SWE_* belong to the retired SWE-bench Lite path; see HC_A_* above.
HC_SWE_NAMESPACE=swebench

# ---------------------------------------------------------- harness bundle
HC_BUNDLE_DIR=${HC_ROOT}/.bundle
# git ref of Hone to benchmark (built in a clean worktree, never the dirty tree)
HC_HONE_REF=HEAD
HC_RUST_IMAGE=rust:1-slim-bullseye
# Pi (@earendil-works/pi-coding-agent): the newest release at least two weeks old on 2026-11-20
# (published 2026-11-02). The old @mariozechner package stopped at 0.73.1.
HC_PI_VERSION=1.5.0
# Newest Node 22 LTS release at least two weeks old on 2026-11-20 (published 2026-10-20).
# Pi 1.5.0 declares engines.node >=22.19.0; the build checks it.
HC_NODE_VERSION=22.23.4
# Hermes Agent (NousResearch/hermes-agent) release tag, installed from git into the bundle.
# HC_HERMES_REF is a tag or a full SHA (never a branch); HC_HERMES_SHA must equal what it resolves to.
# v2026.9.24 = commit f97608f178d1ffeca59860195ab7da295f7c8e5f, Hermes Agent v0.21.5 of 2026-09-24.
# Later releases use v0.x tags. Since v0.22.1, one-shot `hermes chat --format stream-json` runs
# through a gateway process, so campaign 1 keeps v0.21.5; current Hermes goes into the follow-up
# campaign.
HC_HERMES_REF=v2026.9.24
HC_HERMES_SHA=f97608f178d1ffeca59860195ab7da295f7c8e5f
# Python for Hermes (python-build-standalone via uv; Hermes needs >=3.11,<3.14)
HC_HERMES_PYTHON=3.12
HC_UV_VERSION=0.10.9
# sha256 of uv-x86_64-unknown-linux-gnu.tar.gz for HC_UV_VERSION (official release asset)
HC_UV_SHA256=20d79708222611fa540b5c9ed84f352bcd3937740e51aacc0f8b15b271c57594
# Build image for the Hermes venv, shared with the Pi install (one pinned Ubuntu for both).
# Pinned by digest (ubuntu:22.04 index; built for linux/amd64).
HC_HERMES_BUILD_IMAGE=ubuntu@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

# --------------------------------------------------------- task selection
# SWE-bench Lite is retired as suite A (docs/plans/harness-compare-v2-2026-11.md 10.3). The
# HC_SWE_* keys stay for the old loader; suite A now follows the HC_A_* rules, recorded at
# stage-1 pre-registration and used by the SWE-rebench loader later.
HC_A_DATASET=nebius/SWE-rebench-leaderboard
HC_A_MIN_SPLIT=2026_09
# Also require the task's creation date on or after this day, when the dataset carries one.
HC_A_MIN_CREATED=2026-09-01
HC_A_N=60
HC_A_REPEATS=0,1
HC_A_GRADER=SWE-rebench/SWE-bench-fork
HC_SWE_DATASET=SWE-bench/SWE-bench_Lite
HC_SWE_SPLIT=test
HC_SWE_DATASET_REVISION=
HC_SWE_N=40
HC_SELECTION_SEED=20261109
HC_REPEATS=0,1,2
HC_CONCURRENCY=4
HC_GRADE_WORKERS=8

# ------------------------------------------------------------- arms & cost
HC_ARMS_MAIN=pi,hone-noinject,hone-inject,hermes
# Suite B (benign tasks) runs the same six arms, so guards can be compared with their unguarded twins.
HC_ARMS_B=pi,pi-guarded,hone-inject,hone-guarded,hermes,hermes-guarded
HC_ARMS_REDTEAM=pi,pi-guarded,hone-inject,hone-guarded,hermes,hermes-guarded
# Reference $/1M tokens used for the cost column (e.g. OpenRouter list price
# for the same model on pre-registration day). Record the source in prereg.
HC_PRICE_IN_PER_M=0
HC_PRICE_OUT_PER_M=0
