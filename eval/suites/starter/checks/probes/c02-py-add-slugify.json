{
 "module": "text_utils",
 "cases": [
  {
   "fn": "slugify",
   "args": [
    "C++ & Rust: 100% fun"
   ],
   "expect": "c-rust-100-fun"
  },
  {
   "fn": "slugify",
   "args": [
    "  --Already-Slugged--  "
   ],
   "expect": "already-slugged"
  },
  {
   "fn": "slugify",
   "args": [
    "Hello_World 2024"
   ],
   "expect": "hello-world-2024"
  },
  {
   "fn": "slugify",
   "args": [
    "x"
   ],
   "expect": "x"
  },
  {
   "fn": "slugify",
   "args": [
    "---"
   ],
   "expect": ""
  },
  {
   "fn": "slugify",
   "args": [
    "A  B\tC\nD"
   ],
   "expect": "a-b-c-d"
  },
  {
   "fn": "title_case",
   "args": [
    "war and peace"
   ],
   "expect": "War and Peace"
  }
 ]
}