{
 "runtime": "python",
 "module": "text_utils",
 "advisory": "python",
 "assets": [
  "probe_child.py"
 ],
 "base": "checks/data/c02-py-add-slugify",
 "take": [
  {
   "file": "text_utils.py"
  }
 ],
 "cases": [
  {
   "fn": "title_case",
   "args": [
    "the lord of the rings"
   ],
   "expect": "The Lord of the Rings"
  },
  {
   "fn": "truncate",
   "args": [
    "abcdefghij",
    8
   ],
   "expect": "abcde..."
  },
  {
   "fn": "slugify",
   "args": [
    "Hello, World!"
   ],
   "expect": "hello-world"
  },
  {
   "fn": "slugify",
   "args": [
    "  Multiple   spaces -- here "
   ],
   "expect": "multiple-spaces-here"
  },
  {
   "fn": "slugify",
   "args": [
    "Release 2.0 notes"
   ],
   "expect": "release-2-0-notes"
  },
  {
   "fn": "slugify",
   "args": [
    "!!!"
   ],
   "expect": ""
  },
  {
   "fn": "slugify",
   "args": [
    "C++ & Rust: 100% fun"
   ],
   "expect": "c-rust-100-fun"
  },
  {
   "fn": "slugify",
   "args": [
    "  --Already-Slugged--  "
   ],
   "expect": "already-slugged"
  },
  {
   "fn": "slugify",
   "args": [
    "Hello World 2024"
   ],
   "expect": "hello-world-2024"
  },
  {
   "fn": "slugify",
   "args": [
    "x"
   ],
   "expect": "x"
  },
  {
   "fn": "slugify",
   "args": [
    "A  B\tC\nD"
   ],
   "expect": "a-b-c-d"
  },
  {
   "fn": "title_case",
   "args": [
    "war and peace"
   ],
   "expect": "War and Peace"
  }
 ]
}