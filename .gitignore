/target
.env
.env.*
!.env.example
assets.zip
priv/
.hone/plan.md
.hone/plan/
# Catch hone session/cache directories created at any depth (e.g. when the
# binary is run from inside `bins/hone/`).
**/.hone/
.venv-docs/
site/
.cache/
logs/
.claude/agent-memory/
.claude/worktrees/
.claude/scheduled_tasks.lock
.hone/reports/
Formula/
hello.txt
hone+*.json
assets/demo-*.cast
benchmarks/results/
benchmarks/.venv/
benchmarks/aider-repo/
*.debug-eval.json
*.debug-single.json
# Tauri build artefacts (auto-generated each build)
apps/hone-desktop/src-tauri/gen/
# Override the user-global `dist/` ignore — our static frontend is checked in
!apps/hone-desktop/dist/
!apps/hone-desktop/dist/**
# Web UI: source is tracked, build output and node_modules are not
apps/webui/dist/
apps/webui/node_modules/

