{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hone",
  "version": "0.1.0",
  "identifier": "dev.hone.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../dist",
    "devUrl": null
  },
  "app": {
    "windows": [
      {
        "title": "Hone",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "DeveloperTool",
    "publisher": "Hone",
    "copyright": "Copyright (c) Hone contributors. Dual-licensed under MIT and Apache-2.0.",
    "shortDescription": "Hone Desktop — agentic coding shell",
    "longDescription": "Hone Desktop is a Tauri 2 shell for the Hone agentic coding daemon. It spawns or connects to honed and surfaces chat, approvals, agents, recipes, MCP servers, sandbox policies, encrypted memory, provenance chains, and eval-run history — every Hone capability without leaving a desktop window.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": ""
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://releases.hone.dev/desktop/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
