[2.8, "o", "\r\n\u001b[1m/configure\u001b[0m         — show/change config (model, theme, budget, vim)\r\n"]
[2.9, "o", "/model <id>        — switch model\r\n"]
[3.0, "o", "/cost              — show session cost\r\n"]
[3.1, "o", "/tdd [command]     — start TDD file watcher (:tdd off to stop)\r\n"]
[3.2, "o", "/review            — review session changes (hunk accept/reject)\r\n"]
[3.3, "o", "/clarify [prompt]  — ask clarifying questions before coding\r\n"]
[3.4, "o", "/set vim | novim   — toggle vim keybindings\r\n"]
[3.5, "o", "/theme <name>      — switch theme (crimson, neon, chalk, minimal)\r\n"]
[3.6, "o", "/quit  /q          — quit\r\n"]
[3.7, "o", "/help              — this message\r\n"]
[3.8, "o", "\r\n@agent-name [prompt] — invoke specialist (@debugger, @security-auditor, etc.)\r\n"]
[3.9, "o", "!command             — run shell command (!cargo test, !cd src, !nvim file)\r\n"]
